# WeatherGPT Environment Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# AI & LLM Providers (Optional - system automatically falls back to deterministic Indic templates if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Government & External Meteorological APIs (Defaults to high-speed Open-Meteo & IMD open models)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
ERA5_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com/v1

# WMO WIS 2.0 MQTT Broker (Optional)
WIS2_BROKER_URL=
WIS2_TOPIC_PREFIX=wmo/wis2/in-imd

# Spatial Cache Configuration
SPATIAL_CACHE_TTL_SECONDS=900
GEOHASH_PRECISION=6
